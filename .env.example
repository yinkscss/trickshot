# --- Shared ---
NODE_ENV=development

# --- Celo (Alpha = Sepolia testnet) ---
# docs: https://docs.celo.org/build-on-celo/network-overview
CELO_NETWORK=celo-sepolia
CELO_CHAIN_ID=11142220
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Optional: public explorer
CELO_EXPLORER_URL=https://celo-sepolia.blockscout.com

# --- Magic.link (sandbox / test keys) ---
# https://dashboard.magic.link — create app, enable Celo Sepolia
MAGIC_PUBLISHABLE_KEY=pk_live_REPLACE_ME
MAGIC_SECRET_KEY=sk_live_REPLACE_ME

# --- apps/web (Vite) ---
VITE_API_URL=http://localhost:8787
VITE_MAGIC_PUBLISHABLE_KEY=pk_live_REPLACE_ME
VITE_CELO_CHAIN_ID=11142220
VITE_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# --- apps/api ---
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgres://trickshot:trickshot@localhost:5432/trickshot
REDIS_URL=redis://localhost:6379
# Hybrid anti-cheat: HMAC for run attestations (dev only)
RUN_SIGNING_SECRET=dev-only-change-me

# --- contracts (Foundry) ---
# Private key for Celo Sepolia deploys (never commit real keys)
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# --- Goldsky (Beta+) ---
# GOLDSKY_API_KEY=
# GOLDSKY_PROJECT=
