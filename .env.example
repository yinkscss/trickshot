# --- Shared ---
NODE_ENV=development

# --- Celo (Alpha = Sepolia testnet) ---
# docs: https://docs.celo.org/build-on-celo/network-overview
CELO_NETWORK=celo-sepolia
CELO_CHAIN_ID=11142220
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Optional: public explorer
CELO_EXPLORER_URL=https://celo-sepolia.blockscout.com

# --- Magic.link (sandbox / test keys) ---
# https://dashboard.magic.link — create app, enable Celo Sepolia
# Wallet/auth remains Magic (`wallet=magic`); Supabase stores linked user rows.
MAGIC_PUBLISHABLE_KEY=pk_live_REPLACE_ME
MAGIC_SECRET_KEY=sk_live_REPLACE_ME

# --- Supabase (`backend=supabase`) ---
# Local: npx supabase start && npx supabase status
# Cloud: https://supabase.com/dashboard
# Local CLI currently prints Publishable/Secret keys (sb_publishable_/sb_secret_).
# Keep these env names for app compatibility and paste values from supabase status.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Hybrid anti-cheat: HMAC for run attestations (dev only; Edge Function secret)
RUN_SIGNING_SECRET=dev-only-change-me

# --- apps/web (Vite) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=REPLACE_ME
VITE_MAGIC_PUBLISHABLE_KEY=pk_live_REPLACE_ME
VITE_CELO_CHAIN_ID=11142220
VITE_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Mainnet build: VITE_CELO_CHAIN_ID=42220 and VITE_CELO_RPC_URL=https://forno.celo.org
# Deprecated: Fastify stub — prefer Supabase URL for API calls
# VITE_API_URL=http://localhost:8787

# --- contracts (Foundry) ---
# Private key for Celo Sepolia deploys (never commit real keys)
PRIVATE_KEY=
# Blockscout-compatible API key used by forge --verify
ETHERSCAN_API_KEY=

# UUPS deployment init params (required by contracts/script/DeploySepolia.s.sol)
DEPLOY_OWNER=
TREASURY_ADDRESS=
PAYMENT_TOKEN=
CONTINUE_PRICE=100000000000000000

# --- Goldsky (Beta+) ---
# GOLDSKY_API_KEY=
# GOLDSKY_PROJECT=

# --- CI / Staging (GitHub Actions secrets — never commit real values) ---
# These are configured in GitHub → repo → Settings → Secrets and variables → Actions.
# See infra/README.md for the full setup guide.
#
# Supabase staging project (required for deploy-staging.yml)
# SUPABASE_ACCESS_TOKEN=        # supabase login --token output
# SUPABASE_PROJECT_REF=         # e.g. abcdefghijkl (from Supabase dashboard URL)
# SUPABASE_STAGING_URL=         # https://<ref>.supabase.co  (for smoke.yml)
# SUPABASE_STAGING_ANON_KEY=    # staging anon key (for smoke.yml; safe to expose in logs)
#
# Edge Function secrets pushed via `supabase secrets set` (deploy-staging.yml)
# These are never stored in workflow YAML — only in GitHub Actions secrets:
# RUN_SIGNING_SECRET=           # HMAC secret for run attestations (matches local .env)
# MAGIC_SECRET_KEY=             # Magic.link server key (sk_live_...)
# POWERUP_SHOP_ADDRESS=         # Deployed PowerupShop contract on Celo Sepolia
# CELO_RPC_URL=                 # Celo Sepolia RPC endpoint
# CELO_CHAIN_ID=44787           # Optional; defaults to 44787 in deploy workflow
